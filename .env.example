# ── Tor ────────────────────────────────────────────────────────────────
TOR_SOCKS_HOST=127.0.0.1
TOR_SOCKS_PORT=9050
TOR_CONTROL_HOST=127.0.0.1
TOR_CONTROL_PORT=9051
# TOR_CONTROL_PASSWORD=your_password      # only if HashedControlPassword in torrc
# TOR_DATA_DIR=/tmp/tor_data             # DataDirectory path, enables cookie auth
TOR_TIMEOUT=45
TOR_CONNECT_TIMEOUT=15

# ── Behaviour ──────────────────────────────────────────────────────────
XIKIN_MAX_CHARS=8000
XIKIN_SEARCH_WORKERS=8
XIKIN_SCRAPE_WORKERS=5
XIKIN_ENGINE_MAX_RESULTS=40
XIKIN_FETCH_CACHE_TTL=600
XIKIN_SEARCH_CACHE_TTL=1800
XIKIN_ENGINE_CACHE_TTL=3600
# XIKIN_DB_PATH=~/.xikin/xikin.db

# ── LLM (optional — only ask.py and pipeline.py step 7 need it) ────────
LLM_PROVIDER=openai                       # openai | anthropic | gemini | ollama | llamacpp
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com

# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-5

# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=llama3.2                  # fully local, no API key needed

# LLAMACPP_BASE_URL=http://127.0.0.1:8080
# LLAMACPP_MODEL=local-model

XIKIN_LLM_MAX_CHARS=24000
XIKIN_LLM_TIMEOUT=120

# ── Web platform (python -m xikin.web / docker compose up web) ─────────
XIKIN_WEB_HOST=127.0.0.1
XIKIN_WEB_PORT=8080
# Required when the web UI is reachable beyond localhost (Docker sets 0.0.0.0):
# XIKIN_WEB_TOKEN=change_me_to_a_long_random_value
# XIKIN_WEB_RUNS=~/.xikin/web/runs
# Host port for docker compose (default 8080):
# XIKIN_WEB_PUBLISH_PORT=8080
# Watch-job database (default ~/.xikin/web/watch.db):
# XIKIN_WATCH_DB=~/.xikin/web/watch.db
# Webhook for watch new-result alerts (clearnet POST, JSON, retries + signature):
# XIKIN_WEBHOOK_URL=https://hooks.example.com/xikin
# XIKIN_WEBHOOK_SECRET=change_me
# Session signing key (auto-generated in state.db when unset):
# XIKIN_SESSION_SECRET=
# RBAC/user state database (default ~/.xikin/web/state.db):
# XIKIN_STATE_DB=~/.xikin/web/state.db

# Optional VirusTotal enrichment in the web Tools page (clearnet, hash/URL only)
# VT_API_KEY=
